# env files (NUNCA commitear estos archivos con secretos reales)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example SÍ se commitea (plantilla sin valores reales)

# credentials & secrets
*.pem
*.key
*.crt
credentials.json
service-account*.json
secrets/
backups/
database-dumps/

# IDE / editor
.vscode/
.idea/
*.swp
